          "page": 14,
          "tasks": [
            {
              "id": "t1",
              "type": "gap-fill",
              "title": "How many?",
              "instruction": "Look at the numbers and complete: 4 cows, 2 horses, 1 sheep.",
              "text": "There are ___ cows, ___ horses and one ___ on the farm.",
              "blanks": [
                { "answers": ["4", "four"], "hint": "cows" },
                { "answers": ["2", "two"], "hint": "horses" },
                { "answers": ["sheep"], "hint": "singular AND plural!" }
              ]
            },
            {
              "id": "t2",
