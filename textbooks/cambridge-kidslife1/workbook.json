                { "left": "sheep", "right": "lamb" },
                { "left": "horse", "right": "foal" }
              ]
            }
          ]
        },
        {
          "id": "l2",
          "title": "Worksheet 2 — Can / can't",
          "page": 16,
          "tasks": [
            {
              "id": "t1",
