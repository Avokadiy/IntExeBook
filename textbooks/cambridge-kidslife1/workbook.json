      "title": "Unit 1 — My family",
      "lessons": [
        {
          "id": "l1",
          "title": "Worksheet 1 — Possessives",
          "page": 6,
          "tasks": [
            {
              "id": "t1",
              "type": "gap-fill",
              "title": "My / your / his / her",
              "instruction": "Complete with the correct possessive adjective.",
              "text": "1. I have a sister. ___ name is Anna.  2. Tom has a dog. ___ dog is big.  3. You have a book. Is this ___ book?  4. She has a brother. ___ brother is funny.",
              "blanks": [
                { "answers": ["my"], "hint": "about me" },
                { "answers": ["his"], "hint": "Tom = boy" },
                { "answers": ["your"], "hint": "about you" },
                { "answers": ["her"], "hint": "She = girl" }
              ]
            },
            {
              "id": "t2",
              "type": "multiple-choice",
              "title": "Apostrophe s",
              "instruction": "Choose the correct sentence.",
              "options": [
                "This is Marys bag.",
                "This is Mary's bag.",
                "This is Marys' bag.",
                "This is sMary bag."
              ],
              "answerIndex": 1
            }
          ]
        },
        {
          "id": "l2",
          "title": "Worksheet 2 — Reading: Sam's family",
          "page": 8,
          "tasks": [
            {
              "id": "t1",
              "type": "true-false",
              "title": "Read: “Hi, I'm Sam. I have two sisters, Emma and Lily. We don't have a brother!”",
              "instruction": "Sam has one sister.",
              "answer": false,
              "explanation": "Sam has two sisters: Emma and Lily."
            },
            {
              "id": "t2",
              "type": "word-order",
              "title": "About Sam",
              "instruction": "Put the words in order.",
              "words": ["don't", "We", "a", "have", "brother", "."],
              "answer": "We don't have a brother ."
            }
          ]
        }
      ]
    },
    {
      "id": "u2",
