{
  "name": "intexebook",
  "productName": "IntExeBook",
  "version": "1.0.0",
  "description": "Interactive tasks for English teachers — runs 100% locally, no internet needed.",
  "main": "desktop/main.js",
  "author": "IntExeBook",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.intexebook.app",
    "productName": "IntExeBook",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "web/**/*",
      "textbooks/_TEMPLATE/**/*",
      "textbooks/pep-primary-3/**/*",
      "textbooks/cambridge-kidslife1/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "textbooks",
        "to": "textbooks-seed"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "IntExeBook-${version}.exe"
    },
    "portable": {
      "artifactName": "IntExeBook-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "compression": "store"
  }
}